      "spec": {
        "admission": true,
        "background": true,
        "emitWarning": false,
        "rules": [
          {
            "match": {
              "any": [
                {
                  "resources": {
                    "kinds": [
                      "AgentTriggerRule",
                      "AgentProcessTemplate"
                    ]
                  }
                }
              ]
            },
            "name": "deny-competing-scheduling-surfaces",
            "skipBackgroundRequests": true,
            "validate": {
              "allowExistingViolations": true,
              "deny": {},
              "message": "AgentTriggerRule and AgentProcessTemplate creation is denied: knack process code is the single orchestration authority (docs/10 §12.2, §12.3)."
            }
          },
          {
            "match": {
              "any": [
                {
                  "resources": {
                    "kinds": [
                      "AgentDispatchRun"
                    ]
                  }
                }
              ]
            },
            "name": "deny-unlabelled-dispatch",
            "skipBackgroundRequests": true,
            "validate": {
              "allowExistingViolations": true,
              "deny": {
                "conditions": {
                  "any": [
                    {
                      "key": "{{ request.object.metadata.labels.\"kradle.a5c.ai/run\" || '' }}",
                      "operator": "Equals",
                      "value": ""
                    }
                  ]
                }
              },
              "message": "Every AgentDispatchRun MUST carry the knack process-run label kradle.a5c.ai/run (docs/10 §12.2, §12.3)."
            }
          }
        ],
        "validationFailureAction": "Enforce"
      },
